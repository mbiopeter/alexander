# Copy this file to .env.local and replace the blanks.
# Restart npm run dev or rebuild after editing. NEXT_PUBLIC_* values are public.

# Private WhatsApp destination. Use an ACTIVE WhatsApp username when available.
# This is the username assigned inside WhatsApp, not a display name or an assumed
# social handle. A reservation alone may not be active. Optional leading @ accepted.
# Username takes priority; leave it empty until your username link works.
WHATSAPP_USERNAME=

# Private fallback: full international number, digits only, including country code.
# No +, spaces, brackets, or domestic leading zero. It is used only without a username.
# A number-based redirect still reveals the number to anyone opening the chat.
WHATSAPP_NUMBER=

# Existing NEXT_PUBLIC_WHATSAPP_NUMBER / NEXT_PUBLIC_WHATSAPP_USERNAME settings
# remain supported for migration. Remove them after moving to the private keys.
# NEXT_PUBLIC_WHATSAPP_ENABLED is derived automatically by next.config.ts;
# do not put a phone number or username in that public availability flag.

# Paystack Dashboard > Payment Pages: create a donation page with a variable amount.
# Paste its exact hosted link, for example https://paystack.com/pay/YOUR-PAGE-SLUG
# No secret key, public key, payment API, or server is required.
NEXT_PUBLIC_PAYSTACK_PAYMENT_URL=

# Exact public TikTok profile URL, for example https://www.tiktok.com/@YOUR-HANDLE
NEXT_PUBLIC_TIKTOK_URL=

# Optional GitHub profile URL, for example https://github.com/YOUR-USERNAME
NEXT_PUBLIC_GITHUB_URL=

# Optional enquiry email. Use one address you own, without a mailto: prefix.
# It is public when configured; leave blank to hide the email draft option.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional public LinkedIn profile, such as https://www.linkedin.com/in/YOUR-PROFILE/
NEXT_PUBLIC_LINKEDIN_URL=

# Optional CV: a public HTTPS document URL, or a local PDF such as /files/cv.pdf.
# For a local PDF, add the actual document to public/files/cv.pdf before enabling it.
# Leave blank until the document is ready; the site hides unconfigured links.
NEXT_PUBLIC_CV_URL=

# Your deployed HTTPS origin, for example https://YOUR-SITE.example
# Used for canonical and sharing metadata. Leave blank until you know the URL.
NEXT_PUBLIC_SITE_URL=

# Code execution: server-only settings for a compatible Judge0 service.
# Use a real HTTPS endpoint. Documentation/example domains do not connect a runner.
JUDGE0_BASE_URL=

# Set exactly ONE authentication method below, as required by your provider.
JUDGE0_AUTH_TOKEN=
JUDGE0_BEARER_TOKEN=
JUDGE0_RAPIDAPI_KEY=
# Optional with RapidAPI: must match the endpoint hostname.
JUDGE0_RAPIDAPI_HOST=

# Optional: your public origin if a reverse proxy changes the incoming host.
PLAYGROUND_ORIGIN=

# Optional JSON mapping; omit to discover active language versions from /languages.
# Only use actual IDs returned by your own provider.
JUDGE0_LANGUAGE_IDS=
